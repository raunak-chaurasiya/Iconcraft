{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src/lib",
    "outDir": "./dist-lib/types",
    "jsx": "react-jsx"
  },
  "include": ["src/lib"]
}
